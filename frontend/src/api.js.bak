/**
 * Module de communication avec l'API Backend DataPrep Studio.
 */

const API_BASE = '/api';

export async function uploadDataset(file, demo = null) {
  let url = `${API_BASE}/upload`;
  const options = { method: 'POST' };

  if (demo) {
    url += `?demo=${encodeURIComponent(demo)}`;
  } else if (file) {
    const formData = new FormData();
    formData.append('file', file);
    options.body = formData;
  }

  const res = await fetch(url, options);
  if (!res.ok) {
    const err = await res.json().catch(() => ({ detail: 'Erreur rÃ©seau' }));
    throw new Error(err.detail || 'Ã‰chec du chargement du fichier.');
  }
  return res.json();
}

export async function getSession(sessionId) {
  const res = await fetch(`${API_BASE}/session/${sessionId}`);
  if (!res.ok) throw new Error('Session introuvable');
  return res.json();
}

export async function configureSession(payload) {
  const res = await fetch(`${API_BASE}/configure`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  });
  if (!res.ok) throw new Error('Ã‰chec de la configuration');
  return res.json();
}

